# ==========================================
# 1. CONFIGURACIÓN GLOBAL DEL PROYECTO
# ==========================================
APP_NAME=Orquestador Multi-Agente
APP_ENV=local
CONTACT_EMAIL=tu_email@dominio.com

# True para desarrollo sin consumir APIs reales.
# False para consumir OpenAI, Anthropic y Gemini reales.
USE_MOCK_APIS=True

DEFAULT_USUARIO_CONFIG_ID=1


# ==========================================
# 2. BACKEND FASTAPI
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_AGENT_STEPS=8
STREAM_CHAR_DELAY_SECONDS=0.01


# ==========================================
# 3. FRONTEND NEXT.JS
# ==========================================
NEXT_PUBLIC_APP_NAME=Orquestador Multi-Agente
NEXT_PUBLIC_BRAND_NAME=Victor Figueroa
NEXT_PUBLIC_DEFAULT_USER_CONFIG_ID=1

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# false = Sprint 1 usa backend real.
# true  = frontend usa mocks.
NEXT_PUBLIC_USE_MOCKS=false

NEXT_PUBLIC_ENABLED_SPRINTS=1,2,3,4


# ==========================================
# 4. RUTAS DE INFRAESTRUCTURA / WORKSPACE
# ==========================================
# Ajustar esta ruta según tu entorno local.
BASE_PROJECTS_DIR=/home/usuario/ruta/al/workspace


# ==========================================
# 5. POSTGRESQL
# ==========================================
POSTGRES_USER=arquitecto
POSTGRES_PASSWORD=cambiar_password
POSTGRES_DB=orquestador_db

# Dentro de Docker:
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://arquitecto:cambiar_password@db:5432/orquestador_db


# ==========================================
# 6. APIs DE INTELIGENCIA ARTIFICIAL
# ==========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ==========================================
# 7. GITHUB / FUTURA INTEGRACIÓN SPRINT 4
# ==========================================
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=