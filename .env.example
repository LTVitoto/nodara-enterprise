# ==========================================
# 1. CONFIGURACIÓN GLOBAL DEL PROYECTO
# ==========================================
APP_NAME=NODARA Enterprise Edition
APP_ENV=local
CONTACT_EMAIL=email@victorfigueroa.cl

# Modo desarrollo:
# True  = usa respuestas mock para Gemini/OpenAI/Claude
# False = usa APIs reales
USE_MOCK_APIS=false

# Usuario config por defecto
DEFAULT_USUARIO_CONFIG_ID=1


# ==========================================
# 2. BACKEND FASTAPI
# ==========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS permitido para frontend local
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Límites operativos del orquestador
MAX_AGENT_STEPS=8
STREAM_CHAR_DELAY_SECONDS=0.01


# ==========================================
# 3. FRONTEND NEXT.JS
# ==========================================
NEXT_PUBLIC_APP_NAME=NODARA Enterprise Edition
NEXT_PUBLIC_BRAND_NAME=Victor Figueroa
NEXT_PUBLIC_DEFAULT_USER_CONFIG_ID=1

# Desde el navegador hacia backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000

# Control frontend:
# false = Sprint 1 consume backend real
# true  = todo mockeado en frontend
NEXT_PUBLIC_USE_MOCKS=false

# Sprints visibles en UI
NEXT_PUBLIC_ENABLED_SPRINTS=1,2,3,4


# ==========================================
# 4. RUTAS DE INFRAESTRUCTURA / WORKSPACE
# ==========================================
# Ruta real WSL mapeada al contenedor backend.
# Aquí se guardarán artefactos, archivos pesados y workspaces de proyectos.
BASE_PROJECTS_DIR=/home/vitoto/email@victorfigueroa.cl

# Recomendado para futuro:
# BASE_PROJECTS_DIR=/home/vitoto/email@victorfigueroa.cl/orquestador_workspace


# ==========================================
# 5. POSTGRESQL
# ==========================================
POSTGRES_USER=arquitecto
POSTGRES_PASSWORD=super_password_secreta_123
POSTGRES_DB=orquestador_db

# IMPORTANTE:
# Dentro de Docker el host es el nombre del servicio: db
# Dentro de Docker el puerto es el interno: 5432
POSTGRES_HOST=db
POSTGRES_PORT=5432

# URL oficial usada por SQLAlchemy async + asyncpg
DATABASE_URL=postgresql+asyncpg://arquitecto:super_password_secreta_123@db:5432/orquestador_db


# ==========================================
# 6. APIs DE INTELIGENCIA ARTIFICIAL
# ==========================================
# En desarrollo local con USE_MOCK_APIS=True estas llaves pueden ser placeholders.
# Cuando USE_MOCK_APIS=False deben ser llaves reales.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=


# ==========================================
# 7. GITHUB / FUTURA INTEGRACIÓN SPRINT 4
# ==========================================
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_DEFAULT_OWNER=
#GITHUB_DEFAULT_REPO=